programa {
  funcao inicio() {
    /*
Exercício 11 — O maior de dois
Aluno: [Jhonatan]
Objetivo: mostrar o maior entre dois números diferentes.
*/
programa {
    funcao inicio() {
        real n1, n2

        // Entrada: recebe os dois números.
        escreva("Digite o primeiro número: ")
        leia(n1)
        escreva("Digite o segundo número: ")
        leia(n2)

        // Decisão: compara os números e mostra o maior.
        se (n1 > n2) {
            escreva("O maior é ", n1, "\n")
        } senao {
            escreva("O maior é ", n2, "\n")
        }
    }
}
  }
}
