programa {
  funcao inicio() {
    /*
Exercício 08 — Positivo ou negativo
Aluno: [Seu nome]
Objetivo: classificar um inteiro; neste exercício, zero conta como positivo.
*/
programa {
    funcao inicio() {
        inteiro numero

        // Entrada: recebe o número inteiro.
        escreva("Digite um número inteiro: ")
        leia(numero)

        // Decisão: valores menores que zero são negativos; os demais são positivos.
        se (numero < 0) {
            escreva("Negativo\n")
        } senao {
            escreva("Positivo\n")
        }
    }
}
  }
}
