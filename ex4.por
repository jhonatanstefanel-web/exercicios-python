programa {
  funcao inicio() {
    /*
Exercício 04 — Celsius para Fahrenheit
Aluno: [Seu nome]
Objetivo: converter uma temperatura de Celsius para Fahrenheit.
*/
programa {
    funcao inicio() {
        real celsius, fahrenheit

        // Entrada: recebe a temperatura em graus Celsius.
        escreva("Temperatura em Celsius: ")
        leia(celsius)

        // Processamento: aplica a fórmula de conversão.
        fahrenheit = celsius * 1.8 + 32

        // Saída: mostra a temperatura convertida.
        escreva(fahrenheit, " °F\n")
    }
}
  }
}
