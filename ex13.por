programa {
  funcao inicio() {
    /*
Exercício 13 — Senha de acesso
Aluno: [Jhonatan]
Objetivo: comparar a senha digitada com a senha correta.
*/
programa {
    funcao inicio() {
        cadeia senha

        // Entrada: lê a senha como texto.
        escreva("Digite a senha: ")
        leia(senha)

        // Decisão: a comparação diferencia letras maiúsculas e minúsculas.
        se (senha == "senai2026") {
            escreva("Acesso liberado\n")
        } senao {
            escreva("Acesso negado\n")
        }
    }
}
  }
}
