programa {
  funcao inicio() {
    /*
Exercício 09 — Par ou ímpar
Aluno: [Seu nome]
Objetivo: verificar se um número inteiro é divisível por dois.
*/
programa {
    funcao inicio() {
        inteiro numero

        // Entrada: lê o número a classificar.
        escreva("Digite um número inteiro: ")
        leia(numero)

        // Decisão: resto zero significa que o número é par.
        se (numero % 2 == 0) {
            escreva("Par\n")
        } senao {
            escreva("Ímpar\n")
        }
    }
}
  }
}
