programa {
  funcao inicio() {
    /*
Exercício 07 — Maior ou menor de idade
Aluno: [Seu nome]
Objetivo: identificar se a pessoa tem 18 anos ou mais.
*/
programa {
    funcao inicio() {
        inteiro idade

        // Entrada: lê a idade da pessoa.
        escreva("Digite a idade: ")
        leia(idade)

        // Decisão: verifica se a idade atinge 18 anos.
        se (idade >= 18) {
            escreva("Maior de idade\n")
        } senao {
            escreva("Menor de idade\n")
        }
    }
}
  }
}
