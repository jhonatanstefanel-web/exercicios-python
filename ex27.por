programa {
  funcao inicio() {
    /*
Exercício 27 — Número no intervalo
Aluno: [Jhonatan]
Objetivo: verificar se um inteiro está entre 1 e 100, inclusive.
*/
programa {
    funcao inicio() {
        inteiro numero

        // Entrada: lê o número inteiro.
        escreva("Digite um número inteiro: ")
        leia(numero)

        // Decisão: os limites 1 e 100 também pertencem ao intervalo.
        se (numero >= 1 e numero <= 100) {
            escreva("Dentro do intervalo\n")
        } senao {
            escreva("Fora do intervalo\n")
        }
    }
}
  }
}
